{
  "name": "presenter-garage-mcp",
  "version": "0.1.0",
  "description": "An MCP server that lets an AI assistant read a ProPresenter 7 library from disk: search and read presentations, run text checks, audit the media bin, and edit slide text with a confirmation and a backup for every change.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "propresenter",
    "church",
    "lyrics"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eugenius1/presenter-garage.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/eugenius1/presenter-garage#for-ai-assistants-mcp",
  "bin": {
    "presenter-garage-mcp": "dist/presenter-garage-mcp.mjs"
  },
  "files": [
    "dist/presenter-garage-mcp.mjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build --logLevel warn",
    "pack:mcpb": "node scripts/pack-mcpb.mjs",
    "prepack": "npm run protos -w @presenter-garage/core && npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@presenter-garage/core": "*",
    "@presenter-garage/node": "*",
    "@anthropic-ai/mcpb": "^2.1.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  }
}
